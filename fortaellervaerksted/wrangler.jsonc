{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fortaellervaerkstedet",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "fortaellervaerksted.eastwood451.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/generated-projects/*"],
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "STORY_ASSETS",
      "bucket_name": "fortaellervaerksted-assets"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SUPABASE_URL": "https://wpriingzftsboauvkmsj.supabase.co",
    "OPENAI_MODEL": "gpt-5.4-mini",
    "OPENAI_IMAGE_MODEL": "gpt-image-2"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
