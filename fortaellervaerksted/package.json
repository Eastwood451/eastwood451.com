{
  "name": "fortaellervaerkstedet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cloud": "node tools/build-cloud-assets.mjs",
    "dev:cloud": "npm run build:cloud && wrangler dev",
    "check:cloud": "npm run build:cloud && wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "deploy": "npm run build:cloud && wrangler deploy",
    "cf-types": "wrangler types worker-configuration.d.ts",
    "import:cloud": "node tools/import-local-data.mjs --execute"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "wrangler": "^4.36.0"
  }
}
